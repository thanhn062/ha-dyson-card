+async def _handle_set_direction_preset(
+    hass: HomeAssistant, call: ServiceCall
+) -> None:
+    """Recall one named direction preset through its native select entity."""
+    device_id = call.data["device_id"]
+    coordinator = await _get_coordinator_from_device_id(hass, device_id)
+    if not coordinator or not coordinator.device:
+        raise ServiceValidationError(
+            f"Dyson device {device_id} was not found or is unavailable"
+        )
+
+    requested = call.data["preset"].strip()
+    presets = get_direction_presets(coordinator)
+    matched = next(
+        (
+            preset["name"]
+            for preset in presets
+            if preset["name"].casefold() == requested.casefold()
+        ),
+        None,
+    )
+    if matched is None:
+        available = ", ".join(preset["name"] for preset in presets) or "none"
+        raise ServiceValidationError(
+            f"Unknown Dyson direction preset: {requested}. Available: {available}"
+        )
+
+    entity_registry = er.async_get(hass)
+    entity_id = entity_registry.async_get_entity_id(
+        "select", DOMAIN, f"{coordinator.serial_number}_direction_preset"
+    )
+    if entity_id is None:
+        raise ServiceValidationError(
+            "The Dyson Direction Preset entity is not available for this device"
+        )
+
+    await hass.services.async_call(
+        "select",
+        "select_option",
+        {"entity_id": entity_id, "option": matched},
+        blocking=True,
+        context=call.context,
+    )
 
 
