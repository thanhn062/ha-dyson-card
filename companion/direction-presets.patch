+"""Persistent saved-direction presets for Dyson devices."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers.dispatcher import async_dispatcher_send
+from homeassistant.util import slugify
+
+CONF_DIRECTION_PRESETS = "direction_presets"
+MAX_DIRECTION_PRESETS = 32
+
+
+def direction_presets_signal(serial_number: str) -> str:
+    """Return the dispatcher signal for one Dyson device."""
+    return f"hass_dyson_direction_presets_updated_{serial_number}"
+
+
+def normalize_direction_presets(value: Any) -> list[dict[str, Any]]:
+    """Normalize, validate, and de-duplicate direction presets by name."""
+    candidates = value if isinstance(value, list) else []
+    presets: list[dict[str, Any]] = []
+    positions: dict[str, int] = {}
+
+    for raw in candidates[:MAX_DIRECTION_PRESETS]:
+        if not isinstance(raw, dict):
+            continue
+        name = str(raw.get("name", "")).strip()[:64]
+        if not name:
+            continue
+        try:
+            direction = max(0, min(350, round(float(raw.get("direction", 0)) / 5) * 5))
+        except (TypeError, ValueError):
+            continue
+        icon = str(raw.get("icon", "mdi:crosshairs-gps")).strip()[:128]
+        if not icon.startswith("mdi:"):
+            icon = "mdi:crosshairs-gps"
+        preset_id = str(raw.get("id", "")).strip()[:128] or slugify(name)
+        normalized = {
+            "id": preset_id,
+            "name": name,
+            "icon": icon,
+            "direction": direction,
+        }
+        name_key = name.casefold()
+        if name_key in positions:
+            presets[positions[name_key]] = normalized
+        else:
+            positions[name_key] = len(presets)
+            presets.append(normalized)
+
+    return presets
+
+
+def get_direction_presets(coordinator: Any) -> list[dict[str, Any]]:
+    """Return normalized presets stored on a Dyson config entry."""
+    return normalize_direction_presets(
+        coordinator.config_entry.data.get(CONF_DIRECTION_PRESETS, [])
+    )
+
+
+def set_direction_presets(
+    hass: HomeAssistant, coordinator: Any, presets: Any
+) -> list[dict[str, Any]]:
+    """Persist presets and notify the device's select entity."""
+    normalized = normalize_direction_presets(presets)
+    updated_data = dict(coordinator.config_entry.data)
+    updated_data[CONF_DIRECTION_PRESETS] = normalized
+    hass.config_entries.async_update_entry(coordinator.config_entry, data=updated_data)
+    async_dispatcher_send(
+        hass,
+        direction_presets_signal(coordinator.serial_number),
+        normalized,
+    )
+    return normalized
