+class DysonDirectionPresetSelect(DysonEntity, SelectEntity):
+    """Select a saved aim direction without changing the current sweep mode."""
+
+    coordinator: DysonDataUpdateCoordinator
+    _ANCP_SPAN_MAP: dict[str, int] = {
+        "0045": 45,
+        "0090": 90,
+        "0180": 180,
+        "0350": 350,
+    }
+
+    def __init__(self, coordinator: DysonDataUpdateCoordinator) -> None:
+        """Initialize the saved-direction select."""
+        super().__init__(coordinator)
+        self._attr_has_entity_name = False
+        self._attr_name = "Dyson Direction Preset"
+        self._attr_unique_id = f"{coordinator.serial_number}_direction_preset"
+        self._attr_icon = "mdi:map-marker-radius"
+
+    @property
+    def options(self) -> list[str]:
+        """Return the persisted preset names."""
+        return [preset["name"] for preset in get_direction_presets(self.coordinator)]
+
+    def _current_center(self) -> int | None:
+        """Return the center of the current device sweep."""
+        if not self.coordinator.device:
+            return None
+        product_state = self.coordinator.data.get("product-state", {})
+        try:
+            lower_data = self.coordinator.device.get_state_value(
+                product_state, "osal", "0000"
+            )
+            upper_data = self.coordinator.device.get_state_value(
+                product_state, "osau", "0350"
+            )
+            lower = int(str(lower_data).lstrip("0") or "0")
+            upper = int(str(upper_data).lstrip("0") or "350")
+            return (lower + upper) // 2
+        except (TypeError, ValueError):
+            return None
+
+    @property
+    def current_option(self) -> str | None:
+        """Return the preset matching the current center, when any."""
+        center = self._current_center()
+        if center is None:
+            return None
+        return next(
+            (
+                preset["name"]
+                for preset in get_direction_presets(self.coordinator)
+                if abs(int(preset["direction"]) - center) <= 2
+            ),
+            None,
+        )
+
+    @property
+    def extra_state_attributes(self) -> dict[str, Any]:
+        """Expose structured presets for the Dyson dashboard card."""
+        return {"presets": get_direction_presets(self.coordinator)}
+
+    async def async_added_to_hass(self) -> None:
+        """Subscribe to config-entry preset changes."""
+        await super().async_added_to_hass()
+        self.async_on_remove(
+            async_dispatcher_connect(
+                self.hass,
+                direction_presets_signal(self.coordinator.serial_number),
+                self._handle_presets_updated,
+            )
+        )
+
+    @callback
+    def _handle_presets_updated(self, _presets: list[dict[str, Any]]) -> None:
+        """Publish options and attributes immediately after a preset edit."""
+        self.async_write_ha_state()
+
+    def _current_span(self) -> int:
+        """Return the configured sweep width, preferring the Dyson preset code."""
+        if not self.coordinator.device:
+            return 0
+        product_state = self.coordinator.data.get("product-state", {})
+        ancp = self.coordinator.device.get_state_value(product_state, "ancp", "")
+        if ancp in self._ANCP_SPAN_MAP:
+            return self._ANCP_SPAN_MAP[ancp]
+        try:
+            lower_data = self.coordinator.device.get_state_value(
+                product_state, "osal", "0000"
+            )
+            upper_data = self.coordinator.device.get_state_value(
+                product_state, "osau", "0000"
+            )
+            lower = int(str(lower_data).lstrip("0") or "0")
+            upper = int(str(upper_data).lstrip("0") or "0")
+            return max(0, min(350, upper - lower))
+        except (TypeError, ValueError):
+            return 0
+
+    @staticmethod
+    def _bounds_for_center(center: int, span: int) -> tuple[int, int]:
+        """Return bounded lower/upper angles while preserving the sweep width."""
+        half_span = span // 2
+        lower = max(0, center - half_span)
+        upper = min(350, center + (span - half_span))
+        if lower == 0:
+            upper = min(350, span)
+        elif upper == 350:
+            lower = max(0, 350 - span)
+        return lower, upper
+
+    async def async_select_option(self, option: str) -> None:
+        """Aim at a saved direction and restore the prior oscillation state."""
+        if not self.coordinator.device:
+            raise HomeAssistantError("Dyson device is unavailable")
+        preset = next(
+            (
+                candidate
+                for candidate in get_direction_presets(self.coordinator)
+                if candidate["name"] == option
+            ),
+            None,
+        )
+        if preset is None:
+            raise ServiceValidationError(f"Unknown Dyson direction preset: {option}")
+
+        product_state = self.coordinator.data.get("product-state", {})
+        was_oscillating = (
+            self.coordinator.device.get_state_value(product_state, "oson", "OFF")
+            == "ON"
+        )
+        center = int(preset["direction"])
+        current_center = self._current_center()
+        current_span = self._current_span()
+        lower, upper = self._bounds_for_center(center, current_span)
+        try:
+            if was_oscillating:
+                await self.coordinator.device.set_oscillation_angles(lower, upper)
+            else:
+                # A stationary Dyson must briefly receive point-aim mode with
+                # oson=ON or it only stores the new angles without moving. For
+                # a zero-width range the device stops naturally at the target.
+                await self.coordinator.device.set_oscillation_angles(center, center)
+
+                # Wait for the physical turn to finish before restoring the
+                # prior stationary state. The delay scales with travel and is
+                # bounded so script execution remains predictable.
+                travel = abs(
+                    center
+                    - (current_center if current_center is not None else center)
+                )
+                settle_seconds = max(1.5, min(7.0, (travel / 30.0) + 0.8))
+                await asyncio.sleep(settle_seconds)
+                if current_span > 0:
+                    await self.coordinator.device.set_oscillation_angles(
+                        lower, upper, oscillating=False
+                    )
+                else:
+                    await self.coordinator.device.set_oscillation(False)
+        except (ConnectionError, TimeoutError) as err:
+            raise HomeAssistantError(f"Dyson communication failed: {err}") from err
+
+        self.async_write_ha_state()
 
 
